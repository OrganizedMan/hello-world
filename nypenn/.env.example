# NJ Transit developer portal credentials (developer.njtransit.com).
# Copy to .env — .env is gitignored and must never be committed.
NJT_USERNAME=
NJT_PASSWORD=

# Verify against your portal docs; see README "Confirming the feed contract".
NJT_BASE_URL=https://raildata.njtransit.com/api/TrainData
NJT_STATION=NY

NYPENN_DB=data/nypenn.db
POLL_INTERVAL_MS=20000
LOG_LEVEL=info

# Server
PORT=3005
JWT_SECRET=
