# Copy this file to .env and fill in the two blanks marked FILL ME IN.
# .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# NJ Transit credentials — FILL ME IN
#   From your account at https://developer.njtransit.com
# ---------------------------------------------------------------------------
NJT_USERNAME=
NJT_PASSWORD=

# ---------------------------------------------------------------------------
# Everything below has working defaults. You can ignore it.
# ---------------------------------------------------------------------------

# NJT feed. If the collector logs "could not locate a departure array",
# check these against your portal docs — see README, "Confirming the feed
# contract".
# Must match which credentials you were issued -- NJT sends separate Test and
# Production ones, and crossing them over reads as "account not found".
#   Test:       https://testraildata.njtransit.com/api/TrainData
NJT_BASE_URL=https://raildata.njtransit.com/api/TrainData
NJT_STATION=NY

# getToken is capped at 10 calls per day and exceeding it locks the account out
# until midnight, so the token is cached here and reused across restarts.
NJT_TOKEN_FILE=data/njt-token.json
NJT_MAX_TOKENS_PER_DAY=4

# Shared database: the collector writes it, the server reads it.
NYPENN_DB=data/nypenn.db

POLL_INTERVAL_MS=20000
OBSERVATION_RETENTION_DAYS=14
LOG_LEVEL=info

PORT=3005

# Cold-start fallbacks, used only for a train with no history at all. Shown
# as low confidence, never green. Example:
#   LINE_PRIORS={"Morris & Essex Line":"4","Northeast Corridor":"2"}
LINE_PRIORS={}

# Optional: rsync target for an off-Pi copy of the nightly backup, e.g.
#   BACKUP_REMOTE=you@laptop:/backups/nypenn/
# BACKUP_REMOTE=
