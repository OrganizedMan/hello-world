[Unit]
Description=NY Penn departure collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/nypenn
EnvironmentFile=/home/pi/nypenn/.env
ExecStart=/usr/bin/node collector/dist/index.js

Restart=always
RestartSec=10
StartLimitIntervalSec=0

KillSignal=SIGTERM
TimeoutStopSec=30

SyslogIdentifier=nypenn-collector

[Install]
WantedBy=multi-user.target
